<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>

		<!-- =====================================================
		     1. SQL SERVER EN DOCKER  (CONEXIÓN ACTIVA)
		     Contenedor: sql_prog2a  ·  Puerto: 1433  ·  BD: OpticaGrupo8
		     ConexionBaseDatos.cs lee esta cadena por su nombre.
		     ===================================================== -->
		<add name = "ConexionSQLServer"
			 connectionString ="Data Source=localhost,1434;Persist Security Info=True;User ID=sa;Password=Prog2_2026*;Encrypt=False;TrustServerCertificate=True;"
			 providerName = "System.Data.SqlClient"/>

		<!-- =====================================================
		     2. POSTGRESQL EN DOCKER  (COMENTADA)
		     Contenedor: postgres_progra2  ·  Puerto: 5432
		     Para usarla: instalar el NuGet Npgsql, crear la BD con los scripts
		     de database/ (versión PostgreSQL) y cambiar la capa Datos
		     (ver ia/skills/crear-pantalla/05_CAPA_DATOS.md, sección 4).
		<add name = "ConexionPostgreSQL"
			 connectionString ="Host=localhost;Port=5432;Database=opticagrupo8;Username=postgres;Password=Prog2_2026*;"
			 providerName = "Npgsql"/>
		     ===================================================== -->

		<!-- =====================================================
		     3. SUPABASE (POSTGRESQL EN LA NUBE)  (COMENTADA)
		     Proyecto: https://qdxlfblrocahnsviapwj.supabase.co
		     Password = contraseña de la BASE DE DATOS (no la anon key).
		     Se ve o se cambia en Supabase: Project Settings → Database.
		     También necesita Npgsql, igual que la conexión 2.
		     OJO: el repo de GitHub es público. Ahí la contraseña queda como
		     <CONTRASEÑA-DE-LA-BD>; cada integrante la escribe solo en su copia.
		<add name = "ConexionSupabase"
			 connectionString ="Host=db.qdxlfblrocahnsviapwj.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<CONTRASEÑA-DE-LA-BD>;SSL Mode=Require;Trust Server Certificate=true;"
			 providerName = "Npgsql"/>

		     Si la conexión directa no funciona (la red no tiene IPv6), usar el
		     "Session pooler" de Supabase (región us-east-2, funciona con IPv4):
		<add name = "ConexionSupabase"
			 connectionString ="Host=aws-0-us-east-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.qdxlfblrocahnsviapwj;Password=<CONTRASEÑA-DE-LA-BD>;SSL Mode=Require;Trust Server Certificate=true;"
			 providerName = "Npgsql"/>
		     ===================================================== -->

	</connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
